# =========================================================================
# IDB Space — contoh konfigurasi lingkungan
# Salin berkas ini menjadi `.env` (atau `.env.local`) lalu sesuaikan nilainya.
# Jangan pernah commit kunci rahasia sungguhan.
# =========================================================================

# Kunci API untuk backend/mock API. Pada fase mockup nilainya bebas;
# service hanya memakainya untuk menandai bahwa konfigurasi sudah diisi.
VITE_API_KEY=mock-idb-space-key

# Base URL backend sungguhan (belum dipakai pada fase mockup).
VITE_API_BASE_URL=

# ── Pengaturan simulasi jaringan ─────────────────────────────────────────
# Jeda respons Mock API dalam milidetik (acak di antara dua nilai ini).
VITE_MOCK_LATENCY_MIN=650
VITE_MOCK_LATENCY_MAX=1400

# Peluang kegagalan "slot direbut orang lain" (0–1).
# 0.15 = sekitar 15% transaksi gagal. Set 0 untuk demo tanpa kegagalan acak.
VITE_MOCK_SLOT_TAKEN_RATE=0.15
